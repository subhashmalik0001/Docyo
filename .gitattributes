# Auto-detect text files and normalize line endings
* text=auto

# Source code files - enforce LF line endings
*.swift text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Binary media files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.icns binary
*.pdf binary
*.mp4 binary
*.mov binary
*.zip binary
*.tar.gz binary
